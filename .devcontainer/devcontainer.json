{
  "name": "Hexbot dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "26"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "minimal",
      "components": "rustfmt,clippy"
    }
  },
  "postCreateCommand": "rustup show active-toolchain && pip install uv && npm install -g pnpm@10.29.3 && pnpm install --frozen-lockfile && npm ci --prefix backend/pi-runtime --ignore-scripts",
  "forwardPorts": [
    9119,
    5173,
    3000,
    4321
  ],
  "portsAttributes": {
    "9119": {
      "label": "hexbot daemon"
    },
    "5173": {
      "label": "web bundle"
    },
    "3000": {
      "label": "connect"
    },
    "4321": {
      "label": "site"
    }
  }
}
