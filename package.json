{
  "name": "hermes-agent",
  "version": "1.0.0",
  "description": "An AI agent with advanced tool-calling capabilities, featuring a flexible toolsets system for organizing and managing tools.",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "postinstall": "echo '✅ Node dependencies installed. Run: python run_agent.py --help'",
    "dev": "node scripts/dev/run.mjs",
    "web:dev": "pnpm --filter @hexbot/web run dev",
    "web:build": "pnpm --filter @hexbot/web run build",
    "web:test": "pnpm --filter @hexbot/web run test",
    "desktop:dev": "pnpm --filter @hexbot/desktop run dev",
    "desktop:build": "pnpm --filter @hexbot/desktop run build",
    "desktop:e2e": "pnpm --filter @hexbot/desktop run e2e",
    "connect:dev": "pnpm --filter @hexbot/connect run dev",
    "connect:build": "pnpm --filter @hexbot/connect run build",
    "connect:test": "pnpm --filter @hexbot/connect run test",
    "site:dev": "pnpm --filter @hexbot/site run dev",
    "site:build": "pnpm --filter @hexbot/site run build",
    "check": "pnpm -r run check",
    "fix": "pnpm -r run fix",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\" \"apps/desktop/src/**/*.ts\" \"scripts/desktop/*.{mjs,cjs}\"",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css}\" \"apps/desktop/src/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The1UNeed/hexbot.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/The1UNeed/hexbot/issues"
  },
  "homepage": "https://github.com/The1UNeed/hexbot#readme",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "10.8.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.64.0"
  },
  "engines": {
    "node": "^22.22.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=10.16.0"
  }
}
