{
  "basename": "^(auth\\.json|connect\\.json|local-device\\.token|hexbot(-runtime)?\\.db.*|pi-approvals.*\\.json|\\.anthropic_oauth\\.json)$",
  "home": "^(\\.env|profiles/[^/]+/\\.env|users/[^/]+/approvals(/.*)?|runtime/provider-auth(/.*)?|desktop-data(/.*)?)$",
  "user": [
    ".codex/auth.json",
    ".hermes/auth.json",
    ".hermes/.env"
  ],
  "sshPublic": "^(config|known_hosts[^/]*|[^/]*\\.pub|authorized_keys)$",
  "skip": [
    "node_modules",
    ".git",
    "bin",
    "venv",
    "native",
    "artifacts",
    "python",
    "cache"
  ],
  "write": {
    "deny": [
      ".netrc",
      ".pgpass",
      ".npmrc",
      ".pypirc",
      ".git-credentials",
      ".aws",
      ".gnupg",
      ".kube",
      ".docker",
      ".azure",
      ".config/gh",
      ".config/gcloud"
    ],
    "ask": [
      ".bashrc",
      ".bash_profile",
      ".profile",
      ".zshrc",
      ".zprofile",
      ".zshenv",
      ".zlogin",
      ".bash_login",
      ".config/fish/config.fish",
      ".xprofile",
      ".gitconfig",
      ".config/git/config",
      ".cargo/config.toml",
      ".cargo/config",
      "Library/LaunchAgents",
      ".config/autostart",
      ".config/systemd",
      ".local/share/systemd/user",
      "/Library/LaunchAgents",
      "/Library/LaunchDaemons"
    ],
    "fileDeny": [
      "/etc",
      "/private/etc"
    ]
  },
  "environment": [
    "PATH",
    "HOME",
    "USER",
    "LOGNAME",
    "SHELL",
    "TMPDIR",
    "TMP",
    "TEMP",
    "LANG",
    "LANGUAGE",
    "TZ",
    "TERM",
    "COLORTERM",
    "SSH_AUTH_SOCK",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR",
    "NODE_EXTRA_CA_CERTS"
  ],
  "displayEnvironment": [
    "DISPLAY",
    "WAYLAND_DISPLAY",
    "XDG_RUNTIME_DIR",
    "XAUTHORITY",
    "DBUS_SESSION_BUS_ADDRESS"
  ]
}
