{
  "basename": "^(mcp-auth\\.json|auth\\.json|connect\\.json|connect-identity\\.key|local-device\\.token|hexbot(-runtime)?\\.db.*|pi-approvals.*\\.json|\\.anthropic_oauth\\.json)$",
  "home": "^(\\.env|profiles/[^/]+/\\.env|users/[^/]+/approvals(/.*)?|runtime/provider-auth(/.*)?|desktop-data(/.*)?)$",
  "user": [
    ".codex/auth.json",
    ".hermes/auth.json",
    ".hermes/.env"
  ],
  "sshPublic": "^(config|known_hosts[^/]*|[^/]*\\.pub|authorized_keys)$",
  "secretFile": "^\\.env(rc|\\.[^/]*)?$",
  "secretFileExample": "\\.(example|sample|template|dist)$",
  "skip": [
    "node_modules",
    ".git",
    "bin",
    "venv",
    "native",
    "artifacts",
    "python",
    "cache"
  ],
  "readDeny": [
    "Library/Keychains",
    "Library/Cookies",
    "Library/Containers/com.apple.Safari/Data/Library/Cookies",
    "Library/Application Support/Google",
    "Library/Application Support/Chromium",
    "Library/Application Support/BraveSoftware",
    "Library/Application Support/Microsoft Edge",
    "Library/Application Support/Arc",
    "Library/Application Support/Vivaldi",
    "Library/Application Support/com.operasoftware.Opera",
    "Library/Application Support/Firefox",
    ".config/google-chrome",
    ".config/chromium",
    ".config/BraveSoftware",
    ".config/microsoft-edge",
    ".config/vivaldi",
    ".config/opera",
    ".mozilla",
    ".local/share/keyrings",
    ".password-store",
    ".config/google-chrome-beta",
    ".config/google-chrome-unstable",
    "snap/firefox",
    "snap/chromium",
    ".var/app/org.mozilla.firefox",
    ".var/app/com.google.Chrome",
    ".var/app/org.chromium.Chromium",
    ".var/app/com.brave.Browser",
    ".var/app/com.microsoft.Edge",
    "%LOCALAPPDATA%/Google",
    "%LOCALAPPDATA%/Chromium",
    "%LOCALAPPDATA%/BraveSoftware",
    "%LOCALAPPDATA%/Microsoft/Edge",
    "%LOCALAPPDATA%/Microsoft/Edge Beta",
    "%LOCALAPPDATA%/Microsoft/Edge Dev",
    "%LOCALAPPDATA%/Microsoft/Edge SxS",
    "%LOCALAPPDATA%/Vivaldi",
    "%APPDATA%/Mozilla",
    "%APPDATA%/Opera Software",
    "%LOCALAPPDATA%/Microsoft/Windows/INetCookies",
    "%LOCALAPPDATA%/Microsoft/Windows/WebCache"
  ],
  "write": {
    "deny": [
      ".netrc",
      ".pgpass",
      ".npmrc",
      ".pypirc",
      ".git-credentials",
      ".aws",
      ".gnupg",
      ".kube",
      ".docker",
      ".azure",
      ".config/gh",
      ".config/gcloud",
      "%APPDATA%/Microsoft/Credentials",
      "%LOCALAPPDATA%/Microsoft/Credentials",
      "%APPDATA%/Microsoft/Vault",
      "%LOCALAPPDATA%/Microsoft/Vault",
      "%APPDATA%/Microsoft/Crypto",
      "%LOCALAPPDATA%/Microsoft/TokenBroker",
      "%LOCALAPPDATA%/Microsoft/OneAuth",
      "%LOCALAPPDATA%/Microsoft/IdentityCache",
      "%APPDATA%/Microsoft/Protect",
      "%APPDATA%/GitHub CLI",
      "%APPDATA%/gcloud",
      "%APPDATA%/postgresql/pgpass.conf"
    ],
    "ask": [
      ".bashrc",
      ".bash_profile",
      ".profile",
      ".zshrc",
      ".zprofile",
      ".zshenv",
      ".zlogin",
      ".bash_login",
      ".config/fish/config.fish",
      ".xprofile",
      ".gitconfig",
      ".config/git/config",
      ".cargo/config.toml",
      ".cargo/config",
      "Library/LaunchAgents",
      ".config/autostart",
      ".config/systemd",
      ".local/share/systemd/user",
      "/Library/LaunchAgents",
      "/Library/LaunchDaemons",
      "Documents/PowerShell",
      "Documents/WindowsPowerShell",
      "%APPDATA%/Microsoft/Windows/PowerShell",
      "%APPDATA%/Microsoft/Windows/Start Menu/Programs/Startup"
    ],
    "fileDeny": [
      "/etc",
      "/private/etc",
      "%SystemRoot%",
      "%ProgramData%",
      "%ProgramFiles%",
      "%ProgramFiles(x86)%",
      "%LOCALAPPDATA%/Programs"
    ]
  },
  "environment": [
    "PATH",
    "HOME",
    "USER",
    "LOGNAME",
    "SHELL",
    "TMPDIR",
    "TMP",
    "TEMP",
    "LANG",
    "LANGUAGE",
    "TZ",
    "TERM",
    "COLORTERM",
    "SSH_AUTH_SOCK",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR",
    "NODE_EXTRA_CA_CERTS",
    "SYSTEMROOT",
    "WINDIR",
    "COMSPEC",
    "USERPROFILE",
    "HOMEDRIVE",
    "HOMEPATH",
    "APPDATA",
    "LOCALAPPDATA",
    "PROGRAMDATA",
    "PATHEXT",
    "USERNAME",
    "PROGRAMFILES",
    "PROGRAMFILES(X86)"
  ],
  "displayEnvironment": [
    "DISPLAY",
    "WAYLAND_DISPLAY",
    "XDG_RUNTIME_DIR",
    "XAUTHORITY",
    "DBUS_SESSION_BUS_ADDRESS"
  ]
}
