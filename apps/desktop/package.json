{
  "name": "@hexbot/desktop",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build --workspace @hexbot/web && node ../../scripts/desktop/stage-python-src.mjs && electron-vite build && node scripts/copy-web.mjs",
    "build:client": "npm run build --workspace @hexbot/web && HEXBOT_EDITION=client electron-vite build && node scripts/copy-web.mjs",
    "dist:mac": "node ../../scripts/desktop/dist.mjs --mac",
    "dist:linux": "node ../../scripts/desktop/dist.mjs --linux",
    "dist:mac:client": "node ../../scripts/desktop/dist.mjs --client --mac",
    "dist:linux:client": "node ../../scripts/desktop/dist.mjs --client --linux",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "electron": "40.10.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "homepage": "https://hexbot.app",
  "description": "Self-hosted multi-agent desktop app",
  "author": {
    "name": "Hexbot contributors",
    "email": "hello@hexbot.app"
  },
  "license": "AGPL-3.0-only"
}
