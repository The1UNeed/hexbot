{
  "name": "@hexbot/desktop",
  "private": true,
  "version": "0.1.5-alpha.1",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node ../../scripts/dev/desktop.mjs dev",
    "build": "pnpm --filter @hexbot/web run build && node ../../scripts/desktop/stage-runtime.mjs && electron-vite build && node scripts/copy-web.mjs",
    "build:client": "pnpm --filter @hexbot/web run build && HEXBOT_EDITION=client electron-vite build && node scripts/copy-web.mjs",
    "dist:mac": "node ../../scripts/desktop/dist.mjs --mac",
    "dist:linux": "node ../../scripts/desktop/dist.mjs --linux",
    "dist:mac:client": "node ../../scripts/desktop/dist.mjs --client --mac",
    "dist:linux:client": "node ../../scripts/desktop/dist.mjs --client --linux",
    "e2e": "playwright test",
    "e2e:lifecycle": "node scripts/lifecycle-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "semver": "7.7.4"
  },
  "devDependencies": {
    "@hermes/shared": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/semver": "7.8.0",
    "electron": "42.11.3",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "homepage": "https://hexbot.app",
  "description": "Self-hosted multi-agent desktop app",
  "author": {
    "name": "Hexbot contributors",
    "email": "hello@hexbot.app"
  },
  "license": "AGPL-3.0-only"
}
