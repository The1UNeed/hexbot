---
import Base from './Base.astro'

const { frontmatter } = Astro.props
const docs = [
  ['Install', '/docs/install/'],
  ['Pairing and LAN', '/docs/pairing-and-lan/'],
  ['Tailscale', '/docs/tailscale/'],
  ['Providers and billing', '/docs/providers/'],
  ['Approvals and Auto mode', '/docs/approvals/'],
  ['Memory', '/docs/memory/'],
  ['Rooms', '/docs/rooms/'],
  ['Dreaming', '/docs/dreaming/'],
  ['Hexbot Connect', '/docs/connect/'],
  ['Multi-user', '/docs/multi-user/'],
  ['Updates', '/docs/updates/'],
  ['CLI', '/docs/cli/'],
]
const current = Astro.url.pathname
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="mx-auto grid max-w-[1120px] gap-10 px-5 py-10 sm:px-8 lg:grid-cols-[14rem_1fr] lg:gap-16">
    <aside class="min-w-0">
      <a class="text-[15px] font-semibold" href="/docs/">Documentation</a>
      <nav aria-label="Documentation" class="-mx-5 mt-3 flex gap-4 overflow-x-auto px-5 pb-2 text-[15px] whitespace-nowrap sm:-mx-8 sm:px-8 lg:mx-0 lg:mt-4 lg:flex-col lg:gap-2 lg:overflow-visible lg:px-0 lg:pb-0 lg:whitespace-normal">
        {docs.map(([label, href]) => (
          <a class:list={['py-0.5 hover:text-accent', current === href ? 'font-semibold' : 'text-mute']} aria-current={current === href ? 'page' : undefined} href={href}>{label}</a>
        ))}
      </nav>
    </aside>
    <article class="prose min-w-0"><h1 class="display-sm">{frontmatter.title}</h1><slot /></article>
  </div>
</Base>
