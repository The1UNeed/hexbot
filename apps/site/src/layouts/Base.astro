---
import '../styles/global.css'
import Logo from '../components/Logo.astro'
import SpeedInsights from '@vercel/speed-insights/astro'

// `analytics` is off on pages whose URL carries private data (the pairing page):
// PostHog and Speed Insights report the full page URL, query string and fragment
// included. PostHog also needs PUBLIC_POSTHOG_KEY at build time, so local and
// preview builds without it show no cookie notice.
// `jsonLd` adds page-specific structured data next to the site-wide
// Organization, WebSite, and breadcrumb entries that search engines read.
interface Props { title?: string; description?: string; analytics?: boolean; noindex?: boolean; type?: 'website' | 'article'; jsonLd?: object[] }
const {
  title = 'Hexbot',
  analytics = true,
  noindex = false,
  type = 'website',
  jsonLd = [],
  description = 'Self-hosted AI teammates with faces, names, and a memory of their own. Rooms for people and bots, your choice of model, running on your own machine.',
} = Astro.props
const pageTitle = title.startsWith('Hexbot') ? title : `${title} | Hexbot`
const canonical = new URL(Astro.url.pathname, Astro.site)
const image = new URL('/og.png', Astro.site)
const github = 'https://github.com/The1UNeed/hexbot'
const posthog = analytics && Boolean(import.meta.env.PUBLIC_POSTHOG_KEY)
const site = Astro.site!.href
const crumbs = Astro.url.pathname.split('/').filter(Boolean)
const structured = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': `${site}#org`, name: 'Hexbot', url: site, logo: new URL('/apple-touch-icon.png', site).href, sameAs: [github] },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site}#site`, name: 'Hexbot', url: site, publisher: { '@id': `${site}#org` } },
  ...(crumbs.length ? [{
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Hexbot', path: '/' }, ...crumbs.map((part, i) => ({
      name: i === crumbs.length - 1 ? title : part.replace(/-/g, ' ').replace(/^./, c => c.toUpperCase()),
      path: `/${crumbs.slice(0, i + 1).join('/')}/`,
    }))].map(({ name, path }, i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(path, site).href })),
  }] : []),
  ...jsonLd,
]
const nav = [['Tools', '/tools/'], ['How it works', '/how-it-works/'], ['Docs', '/docs/'], ['Blog', '/blog/']]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Hexbot" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <title>{pageTitle}</title>
    <link rel="alternate" type="application/rss+xml" title="Hexbot blog" href="/blog/rss.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structured)} />
  </head>
  <body>
    <a class="nightly-bar" href="/download/">
      <span class="nightly-dot" aria-hidden="true"></span>
      <span><strong class="font-semibold">Nightly early access.</strong> <span class="hidden sm:inline">Hexbot ships only as nightly builds for now, so expect rough edges.</span><span class="sm:hidden">Nightly builds only for now.</span></span>
    </a>
    <header class="mx-auto flex max-w-[1120px] items-center justify-between gap-4 px-5 py-5 sm:px-8">
      <a class="flex items-center gap-2.5 text-[17px] font-semibold" href="/"><Logo size={28} />Hexbot</a>
      <nav aria-label="Main" class="flex items-center gap-4 text-[15px] font-medium sm:gap-7">
        {nav.map(([label, href], i) => (
          <a class:list={['hover:text-accent', i === 1 || i === 3 ? 'hidden md:inline' : '']} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined} href={href}>{label}</a>
        ))}
        <a class="hidden hover:text-accent lg:inline" href={github}>GitHub</a>
        <a class="button button-sm" href="/download/">Download</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="mx-auto mt-24 max-w-[1120px] border-t border-line px-5 py-10 sm:px-8">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <div class="flex flex-col gap-3">
          <a class="flex items-center gap-2.5 text-[17px] font-semibold" href="/"><Logo size={28} />Hexbot</a>
          <p class="max-w-[28em] text-[15px] text-mute">Self-hosted AI teammates with memory, rooms, and your choice of model. AGPL-3.0 software, built on Hermes Agent. In nightly early access.</p>
        </div>
        <nav aria-label="Footer" class="grid grid-cols-2 gap-x-10 gap-y-2 text-[15px] sm:grid-cols-3">
          <a class="hover:text-accent" href="/download/">Download</a>
          <a class="hover:text-accent" href="/tools/">Tools</a>
          <a class="hover:text-accent" href="/how-it-works/">How it works</a>
          <a class="hover:text-accent" href="/faq/">FAQ</a>
          <a class="hover:text-accent" href="/blog/">Blog</a>
          <a class="hover:text-accent" href="/docs/">Docs</a>
          <a class="hover:text-accent" href="/docs/install/">Install</a>
          <a class="hover:text-accent" href="/docs/connect/">Connect</a>
          <a class="hover:text-accent" href="/changelog/">Changelog</a>
          <a class="hover:text-accent" href={github}>GitHub</a>
          <a class="hover:text-accent" href="/terms/">Terms</a>
          <a class="hover:text-accent" href="/privacy/">Privacy</a>
          {posthog && <button type="button" class="text-left hover:text-accent" data-consent-open>Cookies</button>}
        </nav>
      </div>
    </footer>
    {posthog && (
      <div id="consent" hidden role="region" aria-label="Cookies" class="fixed inset-x-4 bottom-4 z-50 mx-auto max-w-[520px] rounded-[20px] bg-paper p-5 shadow-[0_8px_30px_rgb(0_0_0/0.12),inset_0_0_0_1px_var(--color-line)]">
        <p class="text-[15px]">Can we count your visit? PostHog sets a cookie and records how you use this site, with anything you type hidden. <a href="/privacy/#this-website">Privacy</a></p>
        <p id="consent-state" hidden class="mt-2 text-[15px] text-mute"></p>
        <div class="mt-4 flex gap-2">
          <button type="button" class="button button-sm" data-consent="granted">Accept</button>
          <button type="button" class="button button-sm" data-consent="denied">Decline</button>
        </div>
      </div>
      <script src="../scripts/analytics.ts"></script>
    )}
    <script src="../scripts/faces.ts"></script>
    {analytics && <SpeedInsights />}
  </body>
</html>
