---
/**
 * Long-form legal pages: an eyebrow, the dates, an "On this page" list, and
 * numbered sections. The page passes its sections as `<section id="...">`
 * blocks with an `<h2>`; the list here is built from the same `sections` prop
 * so the two never drift. Styles are classes only, because the site's CSP
 * blocks style attributes.
 */
import Base from './Base.astro'

interface Props { title: string; description: string; lede: string; effective: string; updated: string; sections: [string, string][] }
const { title, description, lede, effective, updated, sections } = Astro.props
---
<Base title={title} description={description}>
  <div class="mx-auto max-w-[1120px] px-5 py-10 sm:px-8 lg:py-16">
    <p class="text-[13px] font-semibold uppercase tracking-[.08em] text-mute"><a class="hover:text-accent" href="/legal/">Legal</a> · Hexbot</p>
    <h1 class="display-sm mt-3 text-[clamp(2.25rem,6vw,3.5rem)]">{title}</h1>
    <p class="lede mt-4">{lede}</p>
    <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-1 text-[15px] text-mute">
      <div class="flex gap-2"><dt>Effective</dt><dd class="text-ink">{effective}</dd></div>
      <div class="flex gap-2"><dt>Last updated</dt><dd class="text-ink">{updated}</dd></div>
    </dl>
    <div class="mt-10 grid gap-10 lg:grid-cols-[16rem_1fr] lg:gap-16">
      <aside class="min-w-0 lg:sticky lg:top-8 lg:self-start">
        <p class="text-[15px] font-semibold">On this page</p>
        <ol class="mt-3 flex flex-col gap-1.5 text-[15px] text-mute" data-legal-nav>
          {sections.map(([id, label], i) => (
            <li class="flex gap-2"><span class="w-5 shrink-0 tabular-nums">{i + 1}.</span><a class="hover:text-accent" href={`#${id}`}>{label}</a></li>
          ))}
        </ol>
      </aside>
      <article class="prose legal min-w-0"><slot /></article>
    </div>
  </div>
</Base>
<script>
  // Highlight the section in view, so long pages keep their place.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-legal-nav] a')]
  const byId = new Map(links.map(link => [link.hash.slice(1), link]))
  const observer = new IntersectionObserver(entries => {
    for (const entry of entries) {
      const link = byId.get(entry.target.id)
      if (!link) continue
      link.toggleAttribute('aria-current', entry.isIntersecting)
      link.classList.toggle('text-ink', entry.isIntersecting)
      link.classList.toggle('font-semibold', entry.isIntersecting)
    }
  }, { rootMargin: '-10% 0px -70% 0px' })
  for (const id of byId.keys()) { const section = document.getElementById(id); if (section) observer.observe(section) }
</script>
