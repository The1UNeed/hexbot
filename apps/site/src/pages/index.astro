---
import Base from '../layouts/Base.astro'
import Face from '../components/Face.astro'
import Logo from '../components/Logo.astro'
import manifest from '../../public/downloads/manifest.json'

// Until the first public release ships, the download list stays visible but inert.
// The release workflow flips `published` and names the artifacts (docs/release.md);
// the files themselves live on the update server, next to the updater feed.
const published = manifest.published === true
const updates = 'https://updates.hexbot.app'
const builds = (edition: 'full' | 'client', m: { mac: Record<string, string>; linux: Record<string, string> }) => [
  ['macOS, Apple Silicon', `${updates}/${edition}/mac/arm64/${m.mac.arm64}`],
  ['macOS, Intel', `${updates}/${edition}/mac/x64/${m.mac.x64}`],
  ['Linux AppImage', `${updates}/${edition}/linux/x64/${m.linux.AppImage}`],
  ['Linux deb', `${updates}/${edition}/linux/x64/${m.linux.deb}`],
]
const packages = [
  ['Full package', 'The app and the daemon. Install where your bots should live.', builds('full', manifest)],
  ['Client only', 'The app alone. Install on any other computer and pair it.', builds('client', manifest.client)],
] as const

// The three channels, described in docs/channels.md.
const channels = [
  ['Stable', 'Hexbot [alpha]', 'Tagged releases, signed and updatable. Still alpha: expect rough edges and report them.', 'https://github.com/The1UNeed/hexbot/releases', 'Releases on GitHub'],
  ['Nightly', 'Hexbot Nightly', 'Built from the main branch every day. Installs next to the stable app, updates itself to the next nightly, may break.', 'https://github.com/The1UNeed/hexbot/releases?q=nightly', 'Nightlies on GitHub'],
  ['Dev', 'Hexbot Dev', 'The source tree and a ready-made dev container. For contributors and coding agents.', 'https://github.com/The1UNeed/hexbot#develop', 'Develop from source'],
] as const

// The hero crowd: shapes and colours straight from the app's face builder.
// Positions are percentages of a square box so the crowd scales with the viewport.
// They are Tailwind classes, not inline styles: the site's CSP (style-src 'self') blocks style attributes.
const crowd = [
  ['squircle', '#f5a524', 'left-[2%] top-[4%] w-[34%]', 0], ['round', '#3b82f6', 'left-[42%] top-[10%] w-[26%]', 0.7], ['cloud', '#8b5cf6', 'left-[70%] top-[24%] w-[29%]', 2.8],
  ['hex', '#22a55b', 'left-[10%] top-[42%] w-[30%]', 1.4], ['drop', '#ec2f8a', 'left-[45%] top-[40%] w-[22%]', 2.1], ['tri', '#f97316', 'left-[73%] top-[58%] w-[22%]', 4.2],
  ['wide', '#14b8a6', 'left-[24%] top-[72%] w-[27%]', 3.5], ['square', '#9a6242', 'left-[54%] top-[74%] w-[17%]', 4.9],
] as const
---
<Base>
  <section class="mx-auto grid max-w-[1120px] items-center gap-12 px-5 pb-20 pt-10 sm:px-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:pt-20">
    <div class="flex flex-col gap-7">
      <h1 class="display text-[clamp(3rem,8.5vw,4.75rem)]">Bots with faces, names, and a memory of their own.</h1>
      <p class="lede">Hexbot runs a handful of bots on your own Mac, Linux box, or home server. Each one keeps its own notes, works with the model provider you choose, and joins rooms with the people in your house.</p>
      <div class="flex flex-wrap items-center gap-3">
        <a class="button" href="/docs/install/">Read the install guide</a>
        <a class="button button-quiet" href="/docs/">How it works</a>
      </div>
    </div>
    <div class="relative mx-auto aspect-square w-full max-w-[300px] sm:max-w-[400px] lg:max-w-[440px]" aria-hidden="true">
      {crowd.map(([shape, color, position, delay]) => (
        <span class:list={['absolute', position]}><Face shape={shape} color={color} delay={delay} /></span>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1120px] px-5 sm:px-8">
    <div class="overflow-hidden rounded-[18px] border border-line">
      <div class="flex flex-col gap-0.5 border-b border-line px-5 py-3 text-[15px] sm:flex-row sm:items-center sm:justify-between">
        <span class="flex items-center gap-2 font-semibold"><Face shape="squircle" color="#f5a524" size={22} />Kitchen</span>
        <span class="text-mute">A room with Scout, Ledger, and you</span>
      </div>
      <div class="flex flex-col gap-5 px-5 py-6 sm:px-8">
        <div class="flex justify-end">
          <div class="flex flex-col items-end gap-1">
            <span class="text-[13px] text-mute">You</span>
            <span class="bubble">@Scout what did we decide about the trip last month?</span>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Face shape="round" color="#3b82f6" size={30} delay={1.2} />
          <div class="flex flex-col gap-1">
            <span class="text-[13px] text-mute">Scout</span>
            <span class="bubble">The second week of October, the cabin by the lake. Ledger has the deposit receipt from the 14th.</span>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Face shape="hex" color="#22a55b" size={30} delay={2.6} />
          <div class="flex flex-col gap-1">
            <span class="text-[13px] text-mute">Ledger</span>
            <span class="bubble">Deposit was 320 from the shared card. The balance is due two weeks before you leave.</span>
          </div>
        </div>
      </div>
      <div class="px-5 pb-5 sm:px-8">
        <div class="composer" aria-hidden="true">
          <span class="composer-dot text-xl leading-none">+</span>
          <span class="flex-1 text-mute">Message Kitchen</span>
          <span class="composer-dot bg-ink text-paper"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5"/></svg></span>
        </div>
      </div>
    </div>
    <p class="mt-4 max-w-[40em] text-[15px] text-mute">Scout answered from the memory it kept of a chat four weeks earlier. Ledger joined because it was named. Neither one needed you to explain the trip again.</p>
  </section>

  <section class="mx-auto grid max-w-[1120px] gap-10 px-5 pt-24 sm:px-8 lg:grid-cols-3 lg:gap-8">
    <div class="flex flex-col gap-3">
      <Face shape="round" color="#3b82f6" size={44} delay={0.4} />
      <h2 class="display-sm text-[1.6rem]">Memory that lasts</h2>
      <p class="max-w-[36em] text-mute">Every conversation stays until you archive it. Each bot keeps private notes and a searchable history, and a shared core memory holds what all your bots should know. Overnight, bots dream over the day and keep what mattered.</p>
    </div>
    <div class="flex flex-col gap-3">
      <span class="flex"><Face shape="squircle" color="#f5a524" size={44} delay={1.1} /><span class="-ml-2.5"><Face shape="drop" color="#ec2f8a" size={44} delay={2.2} /></span></span>
      <h2 class="display-sm text-[1.6rem]">Rooms for people and bots</h2>
      <p class="max-w-[36em] text-mute">Put several bots and several people in one chat. Mention a bot to bring it in, or pick a main bot that answers when nobody is named. Bots can message each other, and you can watch the whole exchange.</p>
    </div>
    <div class="flex flex-col gap-3">
      <Face shape="hex" color="#22a55b" size={44} delay={1.8} />
      <h2 class="display-sm text-[1.6rem]">Runs where you say</h2>
      <p class="max-w-[36em] text-mute">The daemon lives on one machine and keeps working when the app is closed. Pair a phone or a second laptop with a short code on your network, over Tailscale, or through <a href="/docs/connect/">Hexbot Connect</a> when you are away.</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1120px] gap-10 px-5 pt-24 sm:px-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <h2 class="display-sm text-[clamp(2rem,4.5vw,2.75rem)]">Your data stays on your hardware.</h2>
    <div class="flex flex-col gap-5 text-[1.0625rem]">
      <p>Conversations, memory, files, and provider keys live in <code class="rounded-md bg-wash px-1.5 py-0.5 font-mono text-[.92em]">~/.hexbot</code> on the machine running the daemon. Bring your own API key or a subscription you already pay for.</p>
      <ul class="flex flex-col gap-3 border-t border-line pt-5">
        <li class="grid gap-1 sm:grid-cols-[12rem_1fr]"><strong class="font-semibold">Approvals</strong><span class="text-mute">Tools run only when you say so. Auto mode lets a small model wave through the low-risk ones.</span></li>
        <li class="grid gap-1 sm:grid-cols-[12rem_1fr]"><strong class="font-semibold">Devices you can revoke</strong><span class="text-mute">Every paired phone and laptop appears in settings with a revoke button.</span></li>
        <li class="grid gap-1 sm:grid-cols-[12rem_1fr]"><strong class="font-semibold">Delete means delete</strong><span class="text-mute">Removing a conversation also removes the memory a bot took from it.</span></li>
        <li class="grid gap-1 sm:grid-cols-[12rem_1fr]"><strong class="font-semibold">Connect stays out of the way</strong><span class="text-mute">Hexbot Connect brokers your identity and a hostname. Chat traffic never passes through it.</span></li>
        <li class="grid gap-1 sm:grid-cols-[12rem_1fr]"><strong class="font-semibold">Open source</strong><span class="text-mute">AGPL-3.0. Read it, fork it, run it yourself.</span></li>
      </ul>
    </div>
  </section>

  <section id="channels" class="mx-auto max-w-[1120px] px-5 pt-24 sm:px-8">
    <h2 class="display-sm text-[clamp(2rem,4.5vw,2.75rem)]">Three ways to run it.</h2>
    <p class="lede mt-3">Hexbot is in alpha. Every build says so in its name, so you always know what you are running.</p>
    <div class="mt-8 grid gap-8 md:grid-cols-3">
      {channels.map(([title, name, blurb, href, cta]) => (
        <div class="border-t border-line pt-5">
          <h3 class="text-[1.15rem] font-semibold">{title}</h3>
          <p class="mt-1 font-mono text-[15px] text-mute">{name}</p>
          <p class="mt-3 text-mute">{blurb}</p>
          <a class="mt-4 inline-block hover:text-accent" href={href}>{cta}</a>
        </div>
      ))}
    </div>
  </section>

  <section id="download" class="mx-auto max-w-[1120px] px-5 pt-24 sm:px-8">
    <div class="flex items-center gap-5">
      <Logo tile size={72} class="shrink-0" />
      <h2 class="display-sm text-[clamp(2rem,4.5vw,2.75rem)]">Download</h2>
    </div>
    <p class="lede mt-3">{published ? 'Two packages, both for macOS and Linux.' : `Downloads open with the first public release. Version ${manifest.version} is in testing.`}</p>
    <div class="mt-8 grid gap-8 md:grid-cols-2">
      {packages.map(([title, blurb, downloads]) => (
        <div class="border-t border-line pt-5">
          <h3 class="text-[1.15rem] font-semibold">{title}</h3>
          <p class="mt-1 text-mute">{blurb}</p>
          <ul class="mt-4 flex flex-col">
            {downloads.map(([label, url]) => published ? (
              <li><a class="flex items-center justify-between border-b border-line py-3 hover:text-accent" href={url}><span>{label}</span><span class="text-[15px] text-mute">Download</span></a></li>
            ) : (
              <li class="flex items-center justify-between border-b border-line py-3 text-mute"><span>{label}</span><span class="text-[15px]">Soon</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>
