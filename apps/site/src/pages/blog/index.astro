---
import Base from '../../layouts/Base.astro'
import { posts, postDate } from '../../lib/blog'

const all = await posts()
---
<Base title="Blog" description="News from Hexbot: nightly early access, new features, and what bots did with them.">
  <section class="mx-auto max-w-[820px] px-5 pt-10 sm:px-8 lg:pt-16">
    <h1 class="display text-[clamp(2.75rem,7vw,4.25rem)]">Blog</h1>
    <p class="lede mt-4">What changed, and what the bots did with it. <a href="/blog/rss.xml">RSS</a></p>
    <ul class="mt-10 border-t border-line">
      {all.map(post => (
        <li><a class="group flex flex-col gap-1.5 border-b border-line py-6" href={`/blog/${post.id}/`}>
          <time class="text-[15px] text-mute" datetime={post.data.date.toISOString()}>{postDate(post.data.date)}</time>
          <span class="display-sm text-[1.5rem] group-hover:text-accent">{post.data.title}</span>
          <span class="text-mute">{post.data.description}</span>
        </a></li>
      ))}
    </ul>
  </section>
</Base>
