---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { posts, postDate } from '../../lib/blog'

export async function getStaticPaths() {
  return (await posts()).map(post => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const url = new URL(`/blog/${post.id}/`, Astro.site).href
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  url,
  mainEntityOfPage: url,
  ...(post.data.image ? { image: new URL(post.data.image, Astro.site).href } : {}),
  author: { '@type': 'Organization', name: 'Hexbot', url: Astro.site!.href },
  publisher: { '@id': `${Astro.site!.href}#org` },
}
---
<Base title={post.data.title} description={post.data.description} type="article" jsonLd={[article]}>
  <article class="mx-auto max-w-[40rem] px-5 py-12 sm:px-8 lg:py-16">
    <p class="text-[15px] text-mute"><a class="hover:text-accent" href="/blog/">Blog</a> · <time datetime={post.data.date.toISOString()}>{postDate(post.data.date)}</time></p>
    <div class="prose"><h1 class="display-sm mt-3">{post.data.title}</h1><Content /></div>
  </article>
</Base>
