---
import Base from '../layouts/Base.astro'
const documents = [
  ['Terms of Service', 'The agreement for using hexbot.app and Hex Connect.', '/terms/'],
  ['Privacy Policy', 'What this website, Connect, and the app collect, and what they never see.', '/privacy/'],
  ['Acceptable Use Policy', 'What you may and may not do with Connect and the hostnames it gives you.', '/acceptable-use/'],
  ['Security Policy', 'How Hexbot and Connect are protected, and how to report a vulnerability.', '/security/'],
] as const
---
<Base title="Legal" description="Hexbot's terms of service, privacy policy, acceptable use policy, and security policy.">
  <section class="mx-auto max-w-[820px] px-5 pt-10 sm:px-8 lg:pt-16">
    <h1 class="display text-[clamp(2.75rem,7vw,4.25rem)]">Legal</h1>
    <p class="lede mt-4">Four short documents in plain words. The Hexbot software itself is <a href="https://www.gnu.org/licenses/agpl-3.0.html">AGPL-3.0</a> and is not covered by them.</p>
    <ul class="mt-10 grid gap-3 sm:grid-cols-2">
      {documents.map(([title, text, href]) => (
        <li><a class="flex h-full flex-col gap-2 rounded-[20px] bg-wash p-6 hover:text-accent" href={href}><span class="text-[1.25rem] font-semibold">{title}</span><span class="text-mute">{text}</span></a></li>
      ))}
    </ul>
  </section>
</Base>
