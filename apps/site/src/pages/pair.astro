---
import Base from '../layouts/Base.astro'
---
<Base title="Pair a device" description="Open a Hexbot pairing link or enter its details manually.">
  <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8">
    <p class="text-sm font-black uppercase tracking-[.22em]">Device pairing</p>
    <h1 class="mt-3 text-5xl font-black tracking-[-.055em] sm:text-7xl">Connect to Hexbot</h1>
    <div id="pair-card" class="mt-10 border-2 border-ink bg-white p-6" aria-live="polite">
      <p id="pair-status">Reading the pairing link...</p>
      <div id="pair-details" class="hidden">
        <p class="text-sm">Pairing code</p>
        <p id="pair-code" class="my-3 font-mono text-4xl font-black tracking-widest"></p>
        <p id="pair-address" class="mb-6 text-sm"></p>
        <a id="pair-open" class="inline-block border-2 border-ink bg-acid px-5 py-3 font-black no-underline" href="#">Open in Hexbot</a>
      </div>
    </div>
    <div class="prose mt-8">
      <h2>Pair manually</h2>
      <ol>
        <li>Open Hexbot and choose "Connect to a daemon".</li>
        <li>Enter the host and port shown above.</li>
        <li>Enter the pairing code. Codes expire after ten minutes and work once.</li>
      </ol>
      <p>The code stays after the <code>#</code> in this page's address. Browsers do not send that fragment to this site.</p>
    </div>
  </section>
  <script src="../scripts/pairPage.ts"></script>
</Base>
