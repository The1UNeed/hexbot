---
import Base from '../layouts/Base.astro'
---
<Base title="Pair a device" description="Open a Hexbot pairing link or enter its details manually.">
  <section class="mx-auto max-w-[40rem] px-5 py-12 sm:px-8 lg:py-20">
    <h1 class="display text-[clamp(2.5rem,7vw,3.75rem)]">Pair this device</h1>
    <div id="pair-card" class="mt-8 rounded-[18px] border border-line p-6" aria-live="polite">
      <p id="pair-status">Reading the pairing link...</p>
      <div id="pair-details" class="hidden">
        <p class="text-[15px] text-mute">Pairing code</p>
        <p id="pair-code" class="my-3 font-mono text-4xl font-semibold tracking-[.18em]"></p>
        <p id="pair-address" class="mb-6 text-[15px] text-mute"></p>
        <a id="pair-open" class="button" href="#">Open in Hexbot</a>
      </div>
    </div>
    <div class="prose mt-10">
      <h2>Pair manually</h2>
      <ol>
        <li>Open Hexbot and choose "Connect to a daemon".</li>
        <li>Enter the host and port shown above.</li>
        <li>Enter the pairing code. Codes expire after ten minutes and work once.</li>
      </ol>
      <p>The code stays after the <code>#</code> in this page's address. Browsers do not send that part to this site.</p>
    </div>
  </section>
  <script src="../scripts/pairPage.ts"></script>
</Base>
