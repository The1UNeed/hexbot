---
/**
 * Small drawings of the app for the landing page and How it works, in HTML
 * rather than screenshots so they stay sharp and follow the site's type. The
 * cast is the made-up ceramics studio from the blog: Maya, and her bots
 * Scout, Ledger, and Juniper, looked after by HexBot. Everything is still:
 * the faces are the site's one moving part.
 */
import Face from './Face.astro'

interface Props { name: 'hexbot' | 'heartbeat' | 'computer' | 'visual' | 'faces' | 'plugins' | 'recall' | 'phone' | 'installer' | 'thinking' | 'diagnostics'; class?: string }
const { name, class: className = '' } = Astro.props

const sales = [['Harbourside Market', 2290, 'w-full'], ['Online shop', 1492, 'w-[65%]'], ['Night Market', 861, 'w-[38%]']] as const
const moodRow = [
  ['curious', 'round', '#3b82f6', 'When you ask'],
  ['shy', 'drop', '#ec2f8a', 'When you thank it'],
  ['surprised', 'squircle', '#f5a524', 'When it is urgent'],
  ['confused', 'hex', '#22a55b', 'When a step fails'],
  ['proud', 'cloud', '#8b5cf6', 'After a long job'],
  ['celebrating', 'tri', '#f97316', 'When tests pass'],
  ['drowsy', 'square', '#14b8a6', 'Left alone too long'],
] as const
const plugins = [
  ['Web search', 'Exa', ['Scout', 'Juniper']],
  ['Notion', 'Connected', ['Juniper']],
  ['Image generation', 'FAL', ['Juniper']],
  ['Computer use', 'Cua', ['Scout', 'Ledger']],
] as const
const roster = [
  ['tri', '#14b8a6', 'HexBot', 'Quill is ready. Want a first draft to review?', '9:41', true],
  ['round', '#3b82f6', 'Scout', 'Booked the kiln for Thursday.', '9:12', false],
  ['hex', '#22a55b', 'Studio', 'Ledger: September totals are in.', '8:55', false],
  ['drop', '#ec2f8a', 'Juniper', 'Two newsletter lines, ready to send.', 'Mon', false],
  ['hex', '#22a55b', 'Ledger', 'Supplier invoices reconciled.', 'Sun', false],
] as const
const levels = ['Off', 'Low', 'Medium', 'High', 'Max']
---
{name === 'hexbot' && (
  <div class:list={['scene flex flex-col gap-3', className]}>
    <div class="flex items-center justify-center gap-2 text-[15px] font-semibold"><Face shape="tri" color="#14b8a6" size={24} delay={0.4} />HexBot<span class="chip">Primary bot</span></div>
    <p class="self-end rounded-[18px] bg-ink px-3.5 py-2 text-[15px] text-paper">I need someone to check my newsletter before it goes out.</p>
    <div class="flex items-end gap-2">
      <Face shape="tri" color="#14b8a6" size={26} delay={1.2} />
      <p class="max-w-[30em] rounded-[18px] bg-[#14b8a6]/10 px-3.5 py-2 text-[15px]">I made Quill, a writer who reads drafts for tone, typos, and anything that sounds like a sales pitch. Quill works in your Newsletter folder.</p>
    </div>
    <div class="ml-8 flex items-center gap-3 rounded-2xl border border-line bg-paper px-3 py-2.5">
      <Face shape="square" color="#8b5cf6" size={36} mood="happy" />
      <div class="text-[15px] leading-tight"><strong class="font-semibold">Quill</strong><span class="block text-[13px] text-mute">Writer · on its own model · new</span></div>
    </div>
    <div class="ml-8 rounded-2xl border border-[#f5a524]/50 bg-paper p-3">
      <p class="text-[14px] font-semibold">Approval needed</p>
      <p class="mt-1 text-[14px] text-mute">Delete Fox, with its chat, memory, and scheduled jobs?</p>
      <div class="mt-2.5 flex gap-2"><span class="mini-button mini-button-ink">Approve</span><span class="mini-button">Deny</span></div>
    </div>
  </div>
)}

{name === 'heartbeat' && (
  <div class:list={['scene flex flex-col gap-4', className]}>
    <div class="rounded-2xl bg-paper p-4 font-mono text-[13px] leading-[1.7] shadow-[inset_0_0_0_1px_var(--color-line)]">
      <p class="mb-1 flex justify-between text-mute"><span>HEARTBEAT.md</span><span>4 checks</span></p>
      <p>- Has Sam replied about the studio lease?</p>
      <p>- Is the clay delivery still on for Friday?</p>
      <p>- Has the kiln element dropped below $300?</p>
      <p>- Did anything on my calendar change today?</p>
    </div>
    <ol class="flex items-center justify-between gap-1 px-1 text-[12px] text-mute" aria-label="Heartbeats this morning">
      {['9:00', '9:30', '10:00', '10:30', '11:00'].map((time, i) => (
        <li class="flex flex-col items-center gap-1.5">
          <span class:list={['beat', i === 3 && 'beat-alert']}></span>{time}
        </li>
      ))}
    </ol>
    <div class="flex items-start gap-3 rounded-2xl bg-paper p-3 shadow-[0_12px_30px_-18px_rgb(0_0_0/.35)] ring-1 ring-line">
      <Face shape="round" color="#3b82f6" size={34} mood="surprised" delay={0.7} />
      <div class="text-[14px] leading-snug"><p class="flex justify-between gap-3"><strong class="font-semibold">Scout</strong><span class="text-mute">10:30</span></p><p class="mt-0.5 text-mute">Sam replied about the lease. He can meet Tuesday at 4 and wants the signed page back by Friday.</p></div>
    </div>
  </div>
)}

{name === 'computer' && (
  <div class:list={['scene scene-dark flex flex-col gap-3', className]}>
    <div class="screen">
      <div class="flex items-center justify-between px-3 py-1.5 text-[11px] text-white/60"><span>Activities</span><span>Thu 10:42</span></div>
      <div class="mx-3 mb-3 overflow-hidden rounded-lg bg-[#fafafa] text-ink">
        <div class="flex items-center gap-1.5 border-b border-line bg-wash px-2.5 py-1.5"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="ml-2 flex-1 rounded-full bg-paper px-2 py-0.5 text-[10px] text-mute">supplier-portal.example/orders</span></div>
        <div class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-1.5 p-3 text-[12px]">
          <span class="text-mute">Stoneware clay, 20 kg</span><span>6 bags</span>
          <span class="text-mute">Clear glaze, 5 L</span><span class="field-active">2</span>
          <span class="text-mute">Delivery</span><span>Friday</span>
        </div>
      </div>
      <span class="cursor cursor-a"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 1l11 7-5 1-2 5z" fill="#fff" stroke="#141414" stroke-width="1.2" stroke-linejoin="round"/></svg><Face shape="round" color="#3b82f6" size={18} mood="working" /></span>
      <span class="cursor cursor-b"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 1l11 7-5 1-2 5z" fill="#fff" stroke="#141414" stroke-width="1.2" stroke-linejoin="round"/></svg><Face shape="hex" color="#22a55b" size={18} /></span>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-2 text-[13px] text-white/70">
      <span><strong class="font-semibold text-white">Scout</strong> is typing in the order form · Ledger waits its turn</span>
      <span class="flex gap-2"><span class="mini-button mini-button-light">Take control</span><span class="chip chip-dark">Auto · 1080p</span></span>
    </div>
  </div>
)}

{name === 'visual' && (
  <div class:list={['scene flex items-start gap-2', className]}>
    <Face shape="hex" color="#22a55b" size={28} delay={2.1} />
    <div class="flex-1 rounded-[18px] bg-[#22a55b]/10 p-3">
      <div class="flex items-center justify-between gap-2 px-1 pb-2 text-[14px]"><strong class="font-semibold">September by channel</strong><span class="mini-button">Expand</span></div>
      <div class="rounded-xl bg-paper p-4">
        <p class="text-[12px] text-mute">Sales, NZD</p>
        <ul class="mt-2 flex flex-col gap-2.5">
          {sales.map(([channel, amount, width]) => (
            <li class="grid grid-cols-[8.5rem_1fr] items-center gap-3 text-[13px]">
              <span class="truncate">{channel}</span>
              <span class="flex items-center gap-2"><span class="flex-1"><span class:list={['bar', width]}></span></span><span class="w-[3rem] text-right tabular-nums text-mute">{amount.toLocaleString('en-NZ')}</span></span>
            </li>
          ))}
        </ul>
        <p class="mt-3 border-t border-line pt-2 text-[12px] text-mute">Total 4,643 · speckled mug led on units, 64 to 40</p>
      </div>
      <p class="px-1 pt-2.5 text-[15px]">Harbourside carried the month. The duplicate invoice is counted once.</p>
    </div>
  </div>
)}

{name === 'faces' && (
  <ul class:list={['grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-4 lg:grid-cols-7', className]}>
    {moodRow.map(([mood, shape, color, when], i) => (
      <li class="flex flex-col items-center gap-2 text-center">
        <Face shape={shape} color={color} size={64} mood={mood} delay={[0.4, 1.1, 1.8, 2.6, 3.5, 4.2, 4.9][i]} />
        <span class="font-semibold capitalize">{mood}</span>
        <span class="text-[13px] leading-snug text-mute">{when}</span>
      </li>
    ))}
  </ul>
)}

{name === 'plugins' && (
  <div class:list={['scene flex flex-col gap-3', className]}>
    <ul class="overflow-hidden rounded-2xl bg-paper ring-1 ring-line">
      {plugins.map(([plugin, state, bots]) => (
        <li class="flex items-center justify-between gap-3 border-b border-line px-3.5 py-2.5 last:border-0">
          <span class="text-[14px] leading-tight"><strong class="font-semibold">{plugin}</strong><span class="block text-[12px] text-mute">{state}</span></span>
          <span class="flex gap-1">{bots.map(bot => <span class="chip">{bot}</span>)}</span>
        </li>
      ))}
    </ul>
    <div class="rounded-2xl border border-[#f5a524]/50 bg-paper p-3">
      <p class="flex items-center gap-2 text-[14px] font-semibold"><Face shape="round" color="#3b82f6" size={20} mood="curious" />Scout asks to install a plugin</p>
      <p class="mt-1.5 truncate rounded-lg bg-wash px-2.5 py-1.5 font-mono text-[12px] text-mute">github · npx @modelcontextprotocol/server-github</p>
      <div class="mt-2.5 flex items-center gap-2"><span class="mini-button mini-button-ink">Approve</span><span class="mini-button">Deny</span><span class="ml-auto text-[12px] text-mute">Always asks</span></div>
    </div>
  </div>
)}

{name === 'recall' && (
  <div class:list={['scene flex flex-col gap-2.5', className]}>
    <div class="flex items-end gap-2"><Face shape="drop" color="#ec2f8a" size={24} delay={1.4} /><p class="rounded-[18px] bg-[#ec2f8a]/10 px-3.5 py-2 text-[15px]">Draft one is in the shared folder.</p></div>
    <div class="flex items-center justify-end gap-2">
      <span class="mini-button">Recall</span>
      <p class="recalled rounded-[18px] bg-ink px-3.5 py-2 text-[15px] text-paper">Email it to all 1,200 subscribers now</p>
    </div>
    <p class="text-center text-[13px] text-mute">Recalled. Juniper stopped and forgot it.</p>
    <div class="composer mt-1"><span class="composer-dot">+</span><span class="flex-1 text-[15px]">Email it to me first<span class="caret"></span></span></div>
  </div>
)}

{name === 'phone' && (
  <div class:list={['phone', className]}>
    <div class="flex items-center justify-between px-1 pb-3"><span class="flex h-8 w-8 items-center justify-center rounded-full bg-wash text-[12px] font-semibold">M</span><span class="text-[15px] font-semibold">Chats</span><span class="flex h-8 w-8 items-center justify-center rounded-full bg-wash text-[18px]">+</span></div>
    <div class="mb-2 flex gap-2"><span class="flex-1 rounded-full bg-wash px-3 py-1.5 text-[13px] text-mute">Search</span><span class="flex w-8 items-center justify-center rounded-full bg-wash" aria-hidden="true"><svg viewBox="0 0 12 12" width="12" height="12" fill="currentColor"><rect width="5" height="5" rx="1"/><rect x="7" width="5" height="5" rx="1"/><rect y="7" width="5" height="5" rx="1"/><rect x="7" y="7" width="5" height="5" rx="1"/></svg></span></div>
    <ul>
      {roster.map(([shape, color, title, line, time, pinned], i) => (
        <li class="flex items-center gap-2.5 border-b border-line py-2.5 last:border-0">
          {title === 'Studio'
            ? <span class="relative h-9 w-9 shrink-0"><span class="absolute left-0 top-0"><Face shape="hex" color="#22a55b" size={24} /></span><span class="absolute bottom-0 right-0"><Face shape="drop" color="#ec2f8a" size={24} /></span></span>
            : <Face shape={shape} color={color} size={36} delay={[0.4, 1.1, 1.8, 2.6, 3.5][i]} mood={pinned ? 'listening' : undefined} />}
          <span class="min-w-0 flex-1 leading-tight"><span class="flex justify-between text-[14px] font-semibold">{title}<span class="text-[11px] font-normal text-mute">{time}</span></span><span class="block truncate text-[12px] text-mute">{line}</span></span>
        </li>
      ))}
    </ul>
  </div>
)}

{name === 'installer' && (
  <div class:list={['scene scene-dark font-mono text-[13px] leading-[1.9]', className]}>
    <p class="text-white/50">$ curl -fsSL https://hexbot.app/install.sh | sh</p>
    <p class="mt-2 text-white">What should this computer run?</p>
    <p class="text-white/60">  Full      the app and your bots</p>
    <p class="text-white/60">  Client    the app, for bots elsewhere</p>
    <p class="text-[#f5a524]">› Headless  your bots, no app</p>
    <p class="mt-2 text-white/60">Downloading only Headless… done</p>
    <p class="text-white">hexbot is running. Pair with: hexbot pair</p>
  </div>
)}

{name === 'thinking' && (
  <div class:list={['scene flex flex-col gap-3', className]}>
    <p class="text-[14px] font-semibold">How hard Ledger thinks</p>
    <div class="flex rounded-full bg-paper p-1 ring-1 ring-line">
      {levels.map(level => <span class:list={['flex-1 rounded-full py-1.5 text-center text-[13px]', level === 'High' ? 'bg-ink font-semibold text-paper' : 'text-mute']}>{level}</span>)}
    </div>
    <p class="text-[13px] text-mute">Only the levels the model supports are listed.</p>
  </div>
)}

{name === 'diagnostics' && (
  <div class:list={['scene grid grid-cols-2 gap-2 sm:grid-cols-4 md:grid-cols-2 lg:grid-cols-4', className]}>
    {[['Launch time', '86 ms', 'Start to ready'], ['Uptime', '3 days', 'Since Monday'], ['Prompt cache hits', '91%', 'Last 24 hours'], ['Database cache hits', '97%', '10,949 statements']].map(([label, value, sub]) => (
      <div class="rounded-2xl bg-paper p-3 ring-1 ring-line"><p class="text-[12px] text-mute">{label}</p><p class="display-sm text-[1.35rem]">{value}</p><p class="text-[12px] text-mute">{sub}</p></div>
    ))}
  </div>
)}
