{
  "name": "@hexbot/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src app App.tsx",
    "check": "pnpm run typecheck && pnpm run test && pnpm run lint && node ../../scripts/desktop/third-party-notices.mjs mobile --check",
    "export": "expo export --platform all",
    "testflight": "eas workflow:run .eas/workflows/testflight.yml --non-interactive --wait",
    "testflight:upload": "eas workflow:run .eas/workflows/testflight-upload.yml --non-interactive --wait",
    "testflight:status": "eas submit:status",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ui": "~58.0.20",
    "@expo/vector-icons": "^15.0.2",
    "@hermes/shared": "workspace:*",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "base64-js": "1.5.1",
    "expo": "~58.0.14",
    "expo-audio": "~58.0.9",
    "expo-blur": "~58.0.4",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.11",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "~19.2.4",
    "eas-cli": "24.11.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
