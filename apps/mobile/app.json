{
  "expo": {
    "name": "Hexbot",
    "slug": "hexbot",
    "scheme": "hexbot",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.hexbot.mobile.dev",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Hexbot connects to your daemon on this network.",
        "NSCameraUsageDescription": "Hexbot scans pairing codes with the camera.",
        "NSPhotoLibraryUsageDescription": "Hexbot attaches photos you pick to a message.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/hexbot.icon"
    },
    "android": {
      "package": "app.hexbot.mobile.dev",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Hexbot scans pairing codes with the camera.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hexbot attaches photos you pick to a message."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E0E0E"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
