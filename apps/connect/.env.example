# Public URL and hostname zone
CONNECT_BASE_URL=http://localhost:3000
# Zone that tunnel hostnames live in: each daemon gets <slug>.<CONNECT_DOMAIN>.
# Production uses a registrable domain of its own, never hexbot.app (docs/deploy.md).
CONNECT_DOMAIN=hexbot.test
CONNECT_INGRESS_PORT=9119

# Production database
DATABASE_URL=

# Clerk. DEV_USER_ID replaces Clerk only when the publishable key is unset.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DEV_USER_ID=local-user

# PostHog project key, the same project as hexbot.app. Unset: no cookie notice, nothing sent.
NEXT_PUBLIC_POSTHOG_KEY=

# Cloudflare tunnel and DNS credentials
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=

# Private ES256 JWK as one JSON line. Development generates an ephemeral key.
CONNECT_SIGNING_KEY_JWK=
# JSON array of public JWKs published beside the signing key: the next key before a rotation.
CONNECT_JWKS_EXTRA=
